# Override some defaults so BT stack is enabled
# in this example

#
# BT config
#
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_DYNAMIC_SERVICE=y

# 0=NONE, 1=ERROR, 2=WARN, 3=INFO, 4=DEBUG, 5=VERBOSE
CONFIG_LOG_MAXIMUM_LEVEL=5

# SPI master (used by MAX31865) is polled from task context, not from an ISR,
# so its ISR/HAL code doesn't need to live in IRAM. Frees ~5KB of IRAM.
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n

# A wedged I2C bus can hang motorControlTask indefinitely inside the driver's
# busy-wait. Panicking on watchdog timeout turns that silent freeze (motors
# left running at their last commanded duty forever) into a bounded reboot
# into the safe all-off boot state instead.

# Built-in single-app table's 1MB factory partition is no longer big enough
# for this image (verbose logging + BLE + wifi + https server). 2MB flash has
# ~900KB of headroom to spare, so grow factory into a custom table instead.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
